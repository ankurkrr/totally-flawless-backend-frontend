					"name": "Check Email Exists",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/auth/check-email?email=user@example.com",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "check-email"],
							"query": [
								{
									"key": "email",
									"value": "user@example.com",
									"description": "Email address to check"
								}
							]
						},
						"description": "Check if email exists in the system"
					},
					"response": []
				},
				{
					"name": "Create User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.userId) {",
									"        pm.environment.set(\"user_id\", jsonData.data.userId);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"firstName\": \"John\",\n    \"lastName\": \"Doe\",\n    \"email\": \"john.doe@example.com\",\n    \"phone\": \"9876543210\",\n    \"address\": \"123 Main Street\",\n    \"imgUrl\": \"https://example.com/profile.jpg\",\n    \"countryCode\": \"+1\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/auth/create-user",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "create-user"],
							"description": "Create user account. Note: OTP is generated automatically and sent via SMS. Required fields: firstName, lastName, phone"
						}
					},
					"response": []
				},
				{
					"name": "Get OTP (User)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const jsonData = pm.response.json();",
									"    if (jsonData.token) {",
									"        pm.environment.set(\"auth_token\", jsonData.token);",
									"    }",
									"    if (jsonData.data && jsonData.data.userId) {",
									"        pm.environment.set(\"user_id\", jsonData.data.userId);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/auth/get-otp?phone=9876543210&countryCode=1",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "get-otp"],
							"query": [
								{
									"key": "phone",
									"value": "9876543210",
									"description": "Phone number (10-15 digits)"
								},
								{
									"key": "countryCode",
									"value": "1",
									"description": "Country code (e.g., 1 for US, 91 for India). Optional."
								}
							],
							"description": "Get OTP for user. OTP is generated and sent via SMS. Use this OTP in create-user or token endpoint."
						}
					},
					"response": []
				},
				{
					"name": "Get Token (Login)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const jsonData = pm.response.json();",
									"    const requestBody = pm.request.body.raw ? JSON.parse(pm.request.body.raw) : {};",
									"    const userType = requestBody.userType || 1;",
									"    ",
									"    if (jsonData.data && jsonData.data.accessToken) {",
									"        if (userType === 2) {",
									"            // Artist login",
									"            pm.environment.set(\"artist_token\", jsonData.data.accessToken);",
									"            pm.environment.set(\"artist_id\", jsonData.data.id);",
									"        } else {",
									"            // User login",
									"            pm.environment.set(\"user_token\", jsonData.data.accessToken);",
									"            pm.environment.set(\"user_id\", jsonData.data.id);",
									"        }",
									"    } else if (jsonData.token) {",
									"        if (userType === 2) {",
									"            pm.environment.set(\"artist_token\", jsonData.token);",
									"        } else {",
									"            pm.environment.set(\"user_token\", jsonData.token);",
									"        }",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"phone\": \"9876543210\",\n    \"otp\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/token",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "token"],
							"description": "Login with phone and OTP. Alternative format: { \"id\": \"user-id\", \"userType\": 1, \"otp\": \"123456\" }"
						}
					},
					"response": []
				},
				{
					"name": "Create Artist",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200 || pm.response.code === 201) {",
									"    const jsonData = pm.response.json();",
									"    // Save artist ID",
									"    if (jsonData.data && jsonData.data.id) {",
									"        pm.environment.set(\"artist_id\", jsonData.data.id);",
									"    } else if (jsonData.id) {",
									"        pm.environment.set(\"artist_id\", jsonData.id);",
									"    }",
									"    // Save artist token if provided",
									"    if (jsonData.data && jsonData.data.accessToken) {",
									"        pm.environment.set(\"artist_token\", jsonData.data.accessToken);",
									"        pm.environment.set(\"artist_id\", jsonData.data.id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"firstName\": \"Jane\",\n    \"lastName\": \"Smith\",\n    \"email\": \"jane.smith@example.com\",\n    \"phone\": \"9876543211\",\n    \"address\": \"456 Oak Avenue\",\n    \"geocode\": \"40.7128,-74.0060\",\n    \"city\": \"New York\",\n    \"state\": \"NY\",\n    \"businessType\": 1,\n    \"videoUrl\": \"https://example.com/video.mp4\",\n    \"countryCode\": \"+1\"\n}"
