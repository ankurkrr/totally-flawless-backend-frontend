# ============================================
# LOCAL DEVELOPMENT ENVIRONMENT VARIABLES
# ============================================
# Copy this to .env for local development
# Use your own local database, test API keys, etc.

# ============================================
# DATABASE CONFIGURATION (Local)
# ============================================
# Use your local MySQL database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_local_mysql_password
DB_NAME=flawless_local

# Development Database (if you have a separate dev server)
DB_DEV_HOST=localhost
DB_DEV_PORT=3306
DB_DEV_USER=root
DB_DEV_PASSWORD=your_local_mysql_password
DB_DEV_NAME=flawless_dev
USE_DEV_DB=false

# Database Connection Pool (smaller for local)
DB_CONNECTION_LIMIT=10

# ============================================
# JWT CONFIGURATION
# ============================================
# Use any secret for local development (can be simple)
JWT_SECRET=local_dev_secret_key_12345

# ============================================
# STRIPE CONFIGURATION (Test Mode)
# ============================================
# Use Stripe TEST keys for local development (starts with sk_test_)
# Get from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_test_key_here
# For local webhook testing, use Stripe CLI:
# stripe listen --forward-to localhost:3000/webhook
# This will give you a webhook secret starting with whsec_
STRIPE_WEBHOOK_SECRET=whsec_your_local_webhook_secret_here

# ============================================
# AWS S3 CONFIGURATION (Optional for Local)
# ============================================
# Option 1: Use your own AWS account (test bucket)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_test_aws_access_key
AWS_SECRET_ACCESS_KEY=your_test_aws_secret_key
S3_BUCKET_NAME=your-test-bucket-name

# Option 2: Use local file storage (modify code to save locally)
# Leave these empty and modify upload logic to save to ./uploads folder

# ============================================
# TWILIO CONFIGURATION (Optional for Local)
# ============================================
# Option 1: Use Twilio test credentials
TWILIO_ACCOUNT_SID=your_twilio_test_account_sid
TWILIO_AUTH_TOKEN=your_twilio_test_auth_token
TWILIO_PHONE_NUMBER=your_twilio_test_phone

# Option 2: Skip SMS sending in development (OTP will be logged to console)
# Leave empty - code will log OTP instead of sending SMS

# ============================================
# EMAIL CONFIGURATION (Optional for Local)
# ============================================
# Use your own email or a test email service like Mailtrap
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_app_specific_password

# Or use Mailtrap for testing (no real emails sent):
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USER=your_mailtrap_user
# MAIL_PASSWORD=your_mailtrap_password

# ============================================
# GOOGLE MAPS API (Optional for Local)
# ============================================
# Get a free API key from: https://console.cloud.google.com/
# Or leave empty if you don't need distance calculations
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ============================================
# FIREBASE CONFIGURATION (REQUIRED)
# ============================================
# Firebase is REQUIRED for push notifications - app will fail to start without these
# Get from Firebase Console > Project Settings > Service Accounts
# Download the service account JSON key and extract these values
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY_ID=your_firebase_private_key_id
# Private key with newlines escaped (use \n for line breaks)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your_firebase_client_id

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# LOCAL DEVELOPMENT NOTES
# ============================================
# 1. Create your local MySQL database:
#    CREATE DATABASE flawless_local;
#
# 2. Import your database schema:
#    mysql -u root -p flawless_local < connection/flawless_17102024.sql
#
# 3. For Stripe webhooks locally, use Stripe CLI:
#    stripe listen --forward-to localhost:3000/webhook
#    This will give you a webhook secret to use
#
# 4. OTP will be logged to console in development mode (no SMS sent)
#
# 5. Firebase: REQUIRED - Push notifications are essential
#    App will fail to start if Firebase credentials are missing
#    Ensure all Firebase env vars are set correctly
#
# 6. You can skip AWS S3 and save files locally by modifying upload logic

