# ============================================
# ENVIRONMENT VARIABLES CONFIGURATION
# ============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_HOST=your_database_host
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=your_database_name

# Development Database (Optional)
DB_DEV_HOST=your_dev_database_host
DB_DEV_PORT=3306
DB_DEV_USER=your_dev_database_user
DB_DEV_PASSWORD=your_dev_database_password
DB_DEV_NAME=your_dev_database_name
USE_DEV_DB=false

# Database Connection Pool
DB_CONNECTION_LIMIT=500

# ============================================
# JWT CONFIGURATION
# ============================================
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here

# ============================================
# STRIPE CONFIGURATION
# ============================================
# Get from Stripe Dashboard > Developers > API keys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
# Get this from Stripe Dashboard > Developers > Webhooks > Your webhook endpoint
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ============================================
# AWS S3 CONFIGURATION
# ============================================
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET_NAME=your_s3_bucket_name

# AWS STS Role ARN for temporary credentials (optional but recommended)
# If not set, will use GetSessionToken instead of AssumeRole
# Format: arn:aws:iam::ACCOUNT_ID:role/ROLE_NAME
AWS_STS_ROLE_ARN=arn:aws:iam::YOUR_ACCOUNT_ID:role/UploadRole

# ============================================
# TWILIO CONFIGURATION (SMS OTP)
# ============================================
# Get these from Twilio Console: https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# ============================================
# EMAIL CONFIGURATION (Nodemailer)
# ============================================
MAIL_SERVICE=gmail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_email_password
MAIL_FROM=noreply@totallyflawless.com

# ============================================
# GOOGLE MAPS API (for distance calculations)
# ============================================
# Used in booking assignment logic
# Get from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3000
NODE_ENV=production

# ============================================
# DEVELOPMENT/TESTING CONFIGURATION (Optional)
# ============================================
# Test phone numbers for development (comma-separated)
# OTP will be set to TEST_OTP for these numbers in development mode only
TEST_PHONE_NUMBERS=8149498672,8600865500,9975464418,7303493979,7835994259,7017450821
TEST_OTP=1111

# ============================================
# KEY MANAGEMENT SYSTEM CONFIGURATION
# ============================================
# Enable dynamic key management (stores keys in database instead of env vars)
# Set to true to use Key Management System, false to use environment variables
ENABLE_KEY_MANAGEMENT=false

# Fallback to environment variables if key not found in database
# Useful during migration period. Set to false after all keys are migrated.
FALLBACK_TO_ENV_VARS=true

# Master encryption key for encrypting keys stored in database
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ CRITICAL: Store this securely! If lost, you cannot decrypt existing keys.
MASTER_ENCRYPTION_KEY=your_master_encryption_key_here

# ============================================
# FIREBASE CONFIGURATION (REQUIRED - Push Notifications)
# ============================================
# Firebase is REQUIRED - app will fail to start without these credentials
# Get these from Firebase Console > Project Settings > Service Accounts
# Download the service account JSON key and extract these values
# IMPORTANT: Never commit the JSON file to version control!
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY_ID=your_firebase_private_key_id
# Private key with newlines escaped (use \n for line breaks)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your_firebase_client_id
# Optional: These have defaults but can be overridden
# FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
# FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
# FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
# FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/...

# ============================================
# NOTES
# ============================================
# 1. Firebase credentials are now stored in environment variables (not JSON file)
# 2. Make sure .env is in .gitignore
# 3. For production, generate a new strong JWT_SECRET:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 4. Consider rotating Stripe and AWS keys since they were exposed in code
# 5. Get STRIPE_WEBHOOK_SECRET from Stripe Dashboard after setting up webhook
# 6. To use Key Management System:
#    - Set ENABLE_KEY_MANAGEMENT=true
#    - Generate and set MASTER_ENCRYPTION_KEY
#    - Run: mysql -u root -p your_db < DB/key_management_schema.sql
#    - Run: node scripts/migrateKeysToDatabase.js
#    - See docs/KEY_MANAGEMENT_QUICK_START.md for details

